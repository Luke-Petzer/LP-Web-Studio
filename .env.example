# ─── LP Web Studio environment variables ───
# Copy this file to `.env.local` for local development and set values on Vercel for prod.

# Contact form: lp-os Supabase project. Both have safe built-in defaults in
# code (the URL is not secret, and the publishable key has zero table access —
# it can only call the submit_contact_enquiry RPC) — only set these to
# override, e.g. to point at a different environment.
LP_OS_SUPABASE_URL=
LP_OS_SUPABASE_PUBLISHABLE_KEY=

# Contact form: optional Telegram notification on a successful submission.
# Unset = skipped silently (the Supabase row is still the durable record).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Public URL of the B2B ordering platform demo.
# Drives the "See the Platform in Action" button on /products. While unset,
# that button renders as a disabled "Demo Coming Soon" — set it on Vercel
# before any outreach campaign points prospects at /products.
NEXT_PUBLIC_DEMO_URL=
