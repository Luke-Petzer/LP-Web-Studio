# ─── LP Web Studio environment variables ───
# Copy this file to `.env.local` for local development and set values on Vercel for prod.

# n8n webhook that receives contact-form submissions.
# Currently UNCONFIGURED — the API route returns a 503 with a fallback email
# message until this is set. Point at the production n8n flow URL before launch.
N8N_WEBHOOK_URL=
